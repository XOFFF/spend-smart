name: dockercompose162880739469383335
services:
  db:
    container_name: spend_smart_db
    environment:
      POSTGRES_DB: WebDb
      POSTGRES_PASSWORD: "1594"
      POSTGRES_USER: postgres
    image: postgres:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: pgdata
        target: /var/lib/postgresql
        volume: {}
  spendsmart:
    build:
      context: C:\Users\marke\source\repos\SpendSmart_PostgreSQL_Docker
      dockerfile: SpendSmart/Dockerfile
    command:
      - dotnet
      - SpendSmart.dll
    container_name: spend_smart_api
    depends_on:
      db:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "5000"
      ASPNETCORE_HTTPS_PORTS: "5001"
      ConnectionStrings__WebApiDatabase: Host=db;Port=5432;Database=WebDb;Username=postgres;Password=1594
    image: spendsmart
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5000
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 5001
        published: "5001"
        protocol: tcp
      - mode: ingress
        target: 5000
        protocol: tcp
      - mode: ingress
        target: 5001
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\marke\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\marke\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\marke\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\marke\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
networks:
  default:
    name: dockercompose162880739469383335_default
volumes:
  pgdata:
    name: dockercompose162880739469383335_pgdata